# Neon PostgreSQL connection string
# Get this from: Neon Dashboard → Connect → .env tab
# Change the prefix from postgresql:// to postgresql+psycopg:// for SQLAlchemy
DATABASE_URL=postgresql+psycopg://neondb_owner:YOUR_PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
